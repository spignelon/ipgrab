# Claude Code project notes and session state — not for the public repo.
CLAUDE.md
HANDOFF.md
.claude/

# Runtime data: sqlite db, uploaded images, WAL/shm files.
/data/
*.db
*.db-shm
*.db-wal

# Local secrets/config — copy from .env.example instead.
.env
.env.local

# Compiled binaries.
/netra
/netra-*
*.exe
*.test

# Go build/test artifacts.
*.out
/dist/
/bin/

# Editor/OS cruft.
.vscode/
.idea/
*.swp
.DS_Store

# Misc local envs that sometimes end up in project dirs.
.venv/

# Tailwind build tooling (web/tailwind/) — Node.js is never part of the
# runtime binary or Docker image, only used to compile web/static/app.css
