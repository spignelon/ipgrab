# Copy this file to .env and adjust before running `docker compose up`.

# Port the container publishes on the host.
PORT=8080

# Public base URL used when rendering shareable capture links from the
# dashboard. Must match how visitors will actually reach this instance
# (e.g. your reverse-proxy domain, or a public IP for direct exposure).
BASE_URL=http://localhost:8080

# Required in production: a long random secret used to sign session cookies.
# Generate one with: openssl rand -hex 32
# If unset, the app runs with a throwaway key and every restart logs you out.
SESSION_SECRET=

# Set to true only if this app sits behind a reverse proxy you control
# (nginx, Caddy, Traefik, Cloudflare Tunnel, etc.) that sets
# X-Forwarded-For / X-Real-IP. If you set this to true without a trusted
# proxy in front, visitors can spoof their own IP address in the logs.
TRUST_PROXY=false

# Set to true once you are serving over HTTPS, so session cookies are
# marked Secure.
COOKIE_SECURE=false
